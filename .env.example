APP_CONFIG_PATH=config.example.yaml

DATABASE_URL=
GAMES_INTEL__DATABASE__URL=
GAMES_INTEL__KAFKA__BOOTSTRAP_SERVERS=localhost:9092
GAMES_INTEL__KAFKA__SECURITY_PROTOCOL=SASL_PLAINTEXT
GAMES_INTEL__KAFKA__SASL_MECHANISM=PLAIN
GAMES_INTEL__KAFKA__SASL_USERNAME=kafka
# Required for Compose Kafka SASL. Generate: python -c "import secrets; print(secrets.token_urlsafe(24))"
GAMES_INTEL__KAFKA__SASL_PASSWORD=
# Required for Compose Postgres. Generate: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

GAMES_INTEL__LLM__MODEL=google/gemini-2.5-flash-lite
GAMES_INTEL__LLM__BASE_URL=https://openrouter.ai/api/v1
GAMES_INTEL__LLM__API_KEY=
GAMES_INTEL__LLM__TIMEOUT_SECONDS=60
GAMES_INTEL__EMBEDDINGS__MODEL=openai/text-embedding-3-small
GAMES_INTEL__EMBEDDINGS__BASE_URL=https://openrouter.ai/api/v1
GAMES_INTEL__EMBEDDINGS__VECTOR_DIM=768
GAMES_INTEL__STT__MODEL=whisper-1
GAMES_INTEL__STT__BASE_URL=https://api.openai.com/v1
GAMES_INTEL__STT__API_KEY=
# Optional leftover; LetsPlay uses yt-dlp and does not need a Google key.
GAMES_INTEL__ADAPTERS__YOUTUBE__API_KEY=
